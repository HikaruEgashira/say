# Path to the say binary. Defaults to `say` on PATH.
# Herdr may spawn plugin commands without mise shims on PATH; set an absolute
# path (e.g. ~/.local/share/mise/shims/say) if `say` is not found.
SAY_BIN=say

# Agent statuses that trigger speech, space-separated.
SAY_STATUSES=done blocked

# Number of recent pane lines scanned for the first non-empty content line.
SAY_LINES=12
