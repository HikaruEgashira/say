# Path to the say-hook binary. Defaults to `say-hook` on PATH.
# Herdr may spawn plugin commands without mise shims on PATH; set an absolute
# path (e.g. ~/.local/share/mise/shims/say-hook) if it is not found.
SAY_BIN=say-hook

# Optional custom voice. Keep ID and expected name together so `check` can
# reject a valid but unintended voice.
ELEVENLABS_VOICE_ID=fUjY9K2nAIwlALOwSiwc
ELEVENLABS_VOICE_NAME="Yui - Japanese girl female Anime voice"

# Agent statuses that trigger speech, space-separated.
SAY_STATUSES=done blocked

# Number of recent pane lines scanned by the screen-scrape fallback.
SAY_LINES=40
